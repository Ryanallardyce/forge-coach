    },
    {
      "week": 2,
      "label": "16–22 Nov · Build volume",
      "roundDelta": 0,
      "conditioningRoundDelta": 0,
      "intensity": "RPE 7 · keep 2–3 reps in reserve"
    },
    {
      "week": 3,
      "label": "23–29 Nov · Progress carefully",
      "roundDelta": 0,
      "conditioningRoundDelta": 0,
      "intensity": "RPE 7–8 · add 2.5–5% load ONLY if full interval remains controlled"
