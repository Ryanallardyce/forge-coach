{
  "schemaVersion": 2,
  "planId": "forge-coach-2026-11-23-return-to-training",
  "month": "2026-11",
  "startDate": "2026-11-23",
  "title": "23 November 2026 · Four-week return-to-training foundation",
  "description": "Restart after approximately six weeks away due to illness. Begin with light, controlled sets and optional runs. Complete strength sets at the same station before changing equipment. Progress only if fully recovered, symptoms do not recur and recovery is normal.",
  "schedule": [
    {
      "day": "Monday",
      "type": "gym",
      "sessionId": "A",
      "note": "Return-to-training Session A. Use week 1 and 1 easy set per movement. Stop or cut the session short if fatigue or symptoms return."
    },
    {
      "day": "Tuesday",
      "type": "run",
      "note": "Week 1: 15–25 min comfortable walk or gentle run/walk only if fully recovered. Week 2: 20–30 min easy. Weeks 3–4: gradually extend as tolerated; no hard intervals."
    },
    {
      "day": "Wednesday",
      "type": "gym",
      "sessionId": "B",
      "note": "Optional light Session B if Monday went well and energy/sleep have recovered. Prefer an easy walk if fatigue remains."
    },
    {
      "day": "Thursday",
      "type": "recovery",
      "note": "Recovery walk or 10–15 min gentle mobility; take full rest if unwell or tired."
    },
    {
      "day": "Friday",
      "type": "gym",
      "sessionId": "C",
      "note": "Optional light Session C. Skip if recovering poorly; do not compensate by overloading missed workouts."
    },
    {
      "day": "Saturday",
      "type": "run",
      "note": "Week 1: optional 25–40 min walk/run-walk, not a long run. Week 2: 30–45 min easy. Weeks 3–4: progress only if completely recovered; stay conversational."
    },
    {
      "day": "Sunday",
      "type": "rest",
      "note": "Rest or a light walk. Check energy, sleep, muscle soreness and any recurrence of symptoms before next week."
    }
  ],
  "progression": [
    {
      "week": 1,
      "label": "23–29 Nov · Reintroduce",
      "roundDelta": -2,
      "conditioningRoundDelta": -2,
      "intensity": "RPE 5–6 · one easy set per exercise, 3–4 repetitions in reserve; no heavy efforts or hard finishers"
    },
    {
      "week": 2,
      "label": "30 Nov–6 Dec · Rebuild routine",
      "roundDelta": -1,
      "conditioningRoundDelta": -1,
      "intensity": "RPE 6 · 2 controlled sets per movement, at least 3 repetitions in reserve; optional short easy cardio"
    },
    {
      "week": 3,
      "label": "7–13 Dec · Gradual progress",
      "roundDelta": 0,
      "conditioningRoundDelta": -1,
      "intensity": "RPE 6–7 · up to 3 controlled sets per movement if recovery is normal; no maximal lifts"
    },
    {
      "week": 4,
      "label": "14–20 Dec · Consolidate",
      "roundDelta": -1,
      "conditioningRoundDelta": -1,
      "intensity": "RPE 6–7 · repeat good technique and steady loads; assess readiness for next training cycle"
    }
  ],
