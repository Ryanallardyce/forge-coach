  "title": "9 November 2026 · Four-week strength + conditioning foundation",
  "description": "Starts Monday 9 November. Three timed gym sessions (Mon/Wed/Fri) and two fixed runs (Tue/Sat). Build muscle, preserve running performance, improve mobility and support gradual fat loss.",
  "schedule": [
    {
      "day": "Monday",
      "type": "gym",
      "sessionId": "A"
    },
    {
      "day": "Tuesday",
      "type": "run",
      "note": "Easy conversational run, around 35–50 min. Keep effort easy; avoid speed work while adapting to gym load."
    },
    {
      "day": "Wednesday",
      "type": "gym",
      "sessionId": "B"
    },
    {
      "day": "Thursday",
      "type": "recovery",
      "note": "Optional 10–15 min controlled mobility or a light walk. No compulsory HIIT."
    },
    {
      "day": "Friday",
      "type": "gym",
      "sessionId": "C",
      "note": "Upper-body-biased gym session; protect legs for Saturday’s long run."
    },
    {
      "day": "Saturday",
      "type": "run",
      "note": "Long easy run, initially roughly 60–80 min according to your current running plan. If excessively sore, reduce duration; avoid pushing pace."
    },
    {
      "day": "Sunday",
      "type": "rest",
      "note": "Rest or light walk"
    }
  ],
  "progression": [
    {
      "week": 1,
      "label": "9–15 Nov · Familiarise",
